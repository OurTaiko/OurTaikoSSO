DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
SSO_BASE_URL=http://127.0.0.1:8090
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=postgres://localhost/ourtaiko_sso_dev?host=/tmp&sslmode=disable
OIDC_PRIVATE_KEY_FILE=.data/oidc-private.pem
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
DEFAULT_FROM_EMAIL=OurTaiko <no-reply@localhost>
# SMTP is optional. Local development writes email to .data/emails/.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Read-only source used only by the explicit import_fanmade command.
FANMADE_SOURCE_DATABASE_URL=postgres://localhost/ourtaiko_fanmade?host=/tmp&sslmode=disable
