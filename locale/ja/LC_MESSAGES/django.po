msgid "偏好语言"
msgstr "優先する言語"

#: accounts/views.py:35
msgid "不支持此语言。"
msgstr "この言語には対応していません。"

#: accounts/views.py:64
msgid "验证你的 OurTaiko 邮箱"
msgstr "OurTaiko のメールアドレスを確認"

#: accounts/views.py:65
#, python-format
msgid ""
"请打开下方链接并确认邮箱（30 分钟内有效）：\n"
"\n"
"%(url)s\n"
msgstr ""
"以下のリンクでメールアドレスを確認してください（30 分間有効）：\n"
"\n"
"%(url)s\n"

#: accounts/views.py:76
msgid "注册次数过多，请一小时后再试。"
msgstr "登録回数が多すぎます。1 時間後に再試行してください。"

